{
  "name": "qraft",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "workers/*", "packages/*"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check workers/api/src/index.js && node --check apps/admin/public/app.js && node --check apps/web/public/app.js",
    "dev:api": "wrangler dev --config workers/api/wrangler.toml",
    "deploy:api": "wrangler deploy --config workers/api/wrangler.toml",
    "deploy:admin": "wrangler pages deploy --config apps/admin/wrangler.toml",
    "deploy:web": "wrangler pages deploy --config apps/web/wrangler.toml"
  },
  "devDependencies": { "wrangler": "^4.26.0" }
}
